@model Services.Dtos.ExpenseModel
<h2>Agregar Gasto</h2>
<form asp-action="AddExpense" method="post">
    <input asp-for="Date" type="date" class="form-control" />
    <input asp-for="Category" class="form-control" placeholder="Categoría" />
    <input asp-for="Name" class="form-control" placeholder="Nombre" />
    <input asp-for="Cost" type="number" step="0.01" class="form-control" placeholder="Costo" />
    <input asp-for="Power" class="form-control" placeholder="Poder" />
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>